{
  "name": "smart-safety-access-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API for Smart Safety Access System",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test src/services/ppe-policy.test.ts",
    "start": "node dist/server.js",
    "db:migrate": "sequelize-cli db:migrate --config sequelize-cli.config.cjs",
    "db:migrate:undo": "sequelize-cli db:migrate:undo --config sequelize-cli.config.cjs",
    "db:seed": "sequelize-cli db:seed:all --config sequelize-cli.config.cjs",
    "db:seed:undo": "sequelize-cli db:seed:undo:all --config sequelize-cli.config.cjs"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "mysql2": "^3.14.5",
    "sequelize": "^6.37.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.6",
    "sequelize-cli": "^6.6.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
